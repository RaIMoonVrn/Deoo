<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>VR Hand Control — Rear Camera</title>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#000; font-family:system-ui, sans-serif; }
  #video { position:fixed; inset:0; width:100%; height:100%; object-fit:cover; transform:scaleX(-1); z-index:0; }
  #canvas { position:fixed; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; }
  #hud {
    position:fixed; top:0; left:0; right:0; padding:14px;
    display:flex; justify-content:space-between; align-items:center;
    z-index:3; color:#fff; font-size:13px;
    background:linear-gradient(180deg, rgba(0,0,0,.65), transparent);
  }
  #status { opacity:.85; }
  #dot { display:inline-block; width:9px; height:9px; border-radius:50%; background:#f33; margin-left:6px; vertical-align:middle; }
  #dot.on { background:#0f8; box-shadow:0 0 8px #0f8; }
  #panel {
    position:fixed; bottom:0; left:0; right:0; padding:18px;
    background:linear-gradient(0deg, rgba(0,0,0,.75), transparent);
    z-index:3; color:#fff; text-align:center;
  }
  #panel h1 { font-size:17px; margin-bottom:6px; }
  #panel p { font-size:12.5px; opacity:.8; line-height:1.6; }
  .btn {
    margin-top:12px; padding:13px 26px; border:0; border-radius:24px;
    background:#fff; color:#000; font-weight:700; font-size:14px; cursor:pointer;
  }
  .hidden { display:none; }
  #cursor {
    position:fixed; width:46px; height:46px; border-radius:50%;
    border:2px solid rgba(255,255,255,.9); z-index:2;
    transform:translate(-50%,-50%); pointer-events:none;
    box-shadow:0 0 14px rgba(255,255,255,.35);
    transition:width .08s, height .08s;
  }
  #cursor.pinch { width:26px; height:26px; border-color:#0f8; box-shadow:0 0 18px rgba(0,255,140,.7); }
</style>
</head>
<body>

<video id="video" playsinline muted></video>
<canvas id="canvas"></canvas>
<div id="cursor" class="hidden"></div>

<div id="hud">
  <div id="status"><span id="dot"></span><span id="statusText">جاهز</span></div>
  <div>VR Hand Control</div>
</div>

<div id="panel">
  <h1>تحكم باليد — كاميرا خلفية</h1>
  <p>ارفع يدك أمام الكاميرا الخلفية.<br>قرّب الإبهام والسبابة = نقرة.</p>
  <button class="btn" id="startBtn">تشغيل الكاميرا</button>
</div>

<script>
const video = document.getElementById('video');
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const cursor = document.getElementById('cursor');
const dot = document.getElementById('dot');
const statusText = document.getElementById('statusText');
const panel = document.getElementById('panel');
const startBtn = document.getElementById('startBtn');

let hands, camera;
let lastPinch = false;
let smoothed = {x: window.innerWidth/2, y: window.innerHeight/2};

function setStatus(ok, text) {
  dot.classList.toggle('on', ok);
  statusText.textContent = text;
}

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

function onResults(results) {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
    cursor.classList.add('hidden');
    setStatus(false, 'لا توجد يد');
    lastPinch = false;
    return;
  }

  setStatus(true, 'يد مكتشفة');

  const lm = results.multiHandLandmarks[0];

  // نقطة منتصف بين الإبهام والسبابة = مؤشر مستقر
  const thumb = lm[4];
  const index = lm[8];
  const midX = (thumb.x + index.x) / 2;
  const midY = (thumb.y + index.y) / 2;

  // تنعيم الحركة — يقل الاهتزاز بدون تأخير مزعج
  const alpha = 0.45;
  smoothed.x += (midX * canvas.width - smoothed.x) * alpha;
  smoothed.y += (midY * canvas.height - smoothed.y) * alpha;

  cursor.style.left = smoothed.x + 'px';
  cursor.style.top = smoothed.y + 'px';
  cursor.classList.remove('hidden');

  // pinch: المسافة بين الإبهام والسبابة
  const dx = thumb.x - index.x;
  const dy = thumb.y - index.y;
  const dist = Math.sqrt(dx*dx + dy*dy);
  const isPinch = dist < 0.055;

  if (isPinch && !lastPinch) {
    cursor.classList.add('pinch');
    const el = document.elementFromPoint(smoothed.x, smoothed.y);
    if (el && el.tagName === 'BUTTON') el.click();
  }
  if (!isPinch) cursor.classList.remove('pinch');

  lastPinch = isPinch;

  // رسم الهيكل
  const connections = [
    [0,1],[1,2],[2,3],[3,4],
    [0,5],[5,6],[6,7],[7,8],
    [5,9],[9,10],[10,11],[11,12],
    [9,13],[13,14],[14,15],[15,16],
    [13,17],[17,18],[18,19],[19,20],
    [0,17]
  ];

  ctx.strokeStyle = 'rgba(0,255,150,.85)';
  ctx.lineWidth = 2.5;
  connections.forEach(([a,b]) => {
    ctx.beginPath();
    ctx.moveTo(lm[a].x * canvas.width, lm[a].y * canvas.height);
    ctx.lineTo(lm[b].x * canvas.width, lm[b].y * canvas.height);
    ctx.stroke();
  });

  ctx.fillStyle = 'rgba(255,255,255,.9)';
  lm.forEach(p => {
    ctx.beginPath();
    ctx.arc(p.x * canvas.width, p.y * canvas.height, 4, 0, Math.PI*2);
    ctx.fill();
  });
}

startBtn.addEventListener('click', async () => {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: 'environment' },  // كاميرا خلفية
        width: { ideal: 1280 },
        height: { ideal: 720 },
        frameRate: { ideal: 30 }
      },
      audio: false
    });
    video.srcObject = stream;
    await video.play();

    hands = new Hands({
      locateFile: (file) =>
        `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
    });

    hands.setOptions({
      maxNumHands: 1,
      modelComplexity: 1,       // دقة أعلى من 0
      minDetectionConfidence: 0.6,
      minTrackingConfidence: 0.6
    });

    hands.onResults(onResults);

    camera = new Camera(video, {
      onFrame: async () => { await hands.send({image: video}); },
      width: 1280,
      height: 720
    });
    camera.start();

    panel.classList.add('hidden');
    setStatus(false, 'بانتظار اليد');
  } catch (e) {
    statusText.textContent = 'خطأ: ' + e.message;
  }
});
</script>
</body>
</html>
